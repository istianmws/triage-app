---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRIAGE_METADATA } from '../lib/triage-algorithm';
---

<BaseLayout title="TC-START Prehospital — Triage PSC 119">
  <div class="space-y-8 pb-12">
    <!-- Hero Banner Card -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-red-950 text-white p-6 sm:p-10 shadow-2xl border border-slate-700">
      <!-- Glow ambient background -->
      <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-10 top-0 w-60 h-60 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/20 border border-red-400/30 text-red-300 text-xs font-bold uppercase tracking-wider backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-red-400 animate-ping"></span>
          Layanan Darurat Prehospital PSC 119
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight text-white">
          Triase Cepat Lapangan <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-rose-300 to-amber-300">
            TC-START Prehospital
          </span>
        </h1>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-medium">
          Aplikasi triase lapangan terpadu berdasar metode <strong>START (Simple Triage And Rapid Treatment)</strong> yang diperkaya dengan <strong>Transcultural Nursing Approach</strong> untuk kecepatan klasifikasi & keselamatan korban bencana / gawat darurat.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-wrap items-center gap-3">
          <a
            href="/triage/input"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-2xl font-black text-sm sm:text-base text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 shadow-xl shadow-red-600/30 transition active:scale-95"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            Mulai Triase Pasien
          </a>

          <a
            href="/data-pasien"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl font-bold text-sm text-slate-200 bg-white/10 hover:bg-white/20 border border-white/15 backdrop-blur-md transition active:scale-95"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Data & Riwayat Pasien
          </a>
        </div>
      </div>
    </div>

    <!-- 4 Official Triage Categories Quick Reference Cards -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
            Kartu Referensi Kategori Triase
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Pedoman klasifikasi resmi metode START Prehospital (Prioritas 1 s/d 4)
          </p>
        </div>
        <a href="/tentang" class="text-xs font-bold text-red-600 hover:text-red-700 hidden sm:inline">
          Lihat Flowchart Lengkap &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Merah / Immediate (P1) -->
        <div class="rounded-3xl p-5 bg-gradient-to-b from-red-50 to-rose-100/50 border-2 border-red-300 shadow-sm flex flex-col justify-between space-y-3 relative overflow-hidden group hover:shadow-md transition">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-red-600 text-white">
                Prioritas 1
              </span>
              <span class="w-3.5 h-3.5 rounded-full bg-red-600 animate-pulse"></span>
            </div>
            <h3 class="text-lg font-black text-red-900 tracking-tight">🔴 MERAH / IMMEDIATE</h3>
            <p class="text-xs text-red-950/80 leading-relaxed font-medium">
              Tidak mampu berjalan; Laju napas RR &gt; 30x/m; Nadi radial tidak teraba / CRT &gt; 2 detik; atau kesadaran menurun (P/U).
            </p>
          </div>
          <div class="pt-3 border-t border-red-200/80 text-[11px] font-bold text-red-800">
            Tindakan: Evakuasi & tindakan SEGERA ke RS Rujukan.
          </div>
        </div>

        <!-- Kuning / Delayed (P2) -->
        <div class="rounded-3xl p-5 bg-gradient-to-b from-amber-50 to-yellow-100/50 border-2 border-amber-300 shadow-sm flex flex-col justify-between space-y-3 relative overflow-hidden group hover:shadow-md transition">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500 text-white">
                Prioritas 2
              </span>
              <span class="w-3.5 h-3.5 rounded-full bg-amber-500"></span>
            </div>
            <h3 class="text-lg font-black text-amber-900 tracking-tight">🟡 KUNING / DELAYED</h3>
            <p class="text-xs text-amber-950/80 leading-relaxed font-medium">
              Tidak berjalan namun pernapasan stabil (RR ≤ 30), perfusi adekuat (nadi teraba, CRT ≤ 2s), dan sadar (A/V).
            </p>
          </div>
          <div class="pt-3 border-t border-amber-200/80 text-[11px] font-bold text-amber-800">
            Tindakan: Perawatan dapat ditunda, pantau ketat TTV.
          </div>
        </div>

        <!-- Hijau / Minor (P3) -->
        <div class="rounded-3xl p-5 bg-gradient-to-b from-emerald-50 to-teal-100/50 border-2 border-emerald-300 shadow-sm flex flex-col justify-between space-y-3 relative overflow-hidden group hover:shadow-md transition">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-600 text-white">
                Prioritas 3
              </span>
              <span class="w-3.5 h-3.5 rounded-full bg-emerald-600"></span>
            </div>
            <h3 class="text-lg font-black text-emerald-900 tracking-tight">🟢 HIJAU / MINOR</h3>
            <p class="text-xs text-emerald-950/80 leading-relaxed font-medium">
              Pasien mampu berjalan mandiri ke arah petugas, laju napas dan sirkulasi stabil, cedera minimal.
            </p>
          </div>
          <div class="pt-3 border-t border-emerald-200/80 text-[11px] font-bold text-emerald-800">
            Tindakan: Luka ringan/rawat jalan di titik kumpul aman.
          </div>
        </div>

        <!-- Hitam / Expectant (P4) -->
        <div class="rounded-3xl p-5 bg-gradient-to-b from-slate-100 to-gray-200/70 border-2 border-slate-300 shadow-sm flex flex-col justify-between space-y-3 relative overflow-hidden group hover:shadow-md transition">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-800 text-white">
                Prioritas 4
              </span>
              <span class="w-3.5 h-3.5 rounded-full bg-slate-800"></span>
            </div>
            <h3 class="text-lg font-black text-slate-900 tracking-tight">⚫ HITAM / EXPECTANT</h3>
            <p class="text-xs text-slate-700 leading-relaxed font-medium">
              Tidak ada tanda napas spontan meski jalan napas telah dibuka (Head tilt-chin lift/jaw thrust).
            </p>
          </div>
          <div class="pt-3 border-t border-slate-300 text-[11px] font-bold text-slate-800">
            Tindakan: Tidak dapat diselamatkan/kantong jenazah.
          </div>
        </div>
      </div>
    </div>

    <!-- Transcultural Nursing Approach Section -->
    <div class="rounded-3xl bg-white border border-slate-200/90 p-6 sm:p-8 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-red-600 mb-1">
            <span class="w-2 h-2 rounded-full bg-red-600"></span>
            Nilai Keperawatan Lintas Budaya
          </div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            Transcultural Nursing Approach
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            4 Pilar Komunikasi Terapeutik & Sensitivitas Budaya pada Pelayanan Prehospital PSC 119
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs sm:text-sm">
        <!-- Pilar 1 -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <div class="w-8 h-8 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-black">
            1
          </div>
          <h4 class="font-extrabold text-slate-900">Bahasa & Komunikasi</h4>
          <p class="text-slate-600 leading-relaxed text-xs">
            Gunakan bahasa ibu / daerah yang dimengerti pasien (Indonesia, Jawa, Madura, Sunda) guna menurunkan kecemasan korban.
          </p>
        </div>

        <!-- Pilar 2 -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <div class="w-8 h-8 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-black">
            2
          </div>
          <h4 class="font-extrabold text-slate-900">Sensitivitas Gender & Privasi</h4>
          <p class="text-slate-600 leading-relaxed text-xs">
            Jaga martabat dan aurat pasien saat pemeriksaan pakaian/cedera, sediakan pendamping sesama gender bila memungkinkan.
          </p>
        </div>

        <!-- Pilar 3 -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <div class="w-8 h-8 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center font-black">
            3
          </div>
          <h4 class="font-extrabold text-slate-900">Respons Terhadap Nyeri</h4>
          <p class="text-slate-600 leading-relaxed text-xs">
            Hargai ekspresi nyeri khas budaya lokal (doa, dzikir, erangan) secara empatik tanpa menghakimi toleransi nyeri korban.
          </p>
        </div>

        <!-- Pilar 4 -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-black">
            4
          </div>
          <h4 class="font-extrabold text-slate-900">Dukungan Keluarga</h4>
          <p class="text-slate-600 leading-relaxed text-xs">
            Libatkan keluarga terdekat dalam proses pendampingan ambulans untuk memberikan dukungan psikologis yang menenangkan.
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Navigation Hub -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href="/data-pasien"
        class="bg-white p-5 rounded-2xl border border-slate-200/90 hover:border-red-300 shadow-sm hover:shadow-md transition group"
      >
        <div class="flex items-center justify-between">
          <div class="space-y-1">
            <h3 class="text-base font-black text-slate-900 group-hover:text-red-600 transition">
              Data & Riwayat Pasien
            </h3>
            <p class="text-xs text-slate-500">Lihat rekap kasus, pencarian nama & filter tanggal kejadian.</p>
          </div>
          <span class="text-slate-400 group-hover:text-red-600 transition text-lg font-bold">&rarr;</span>
        </div>
      </a>

      <a
        href="/pengaturan"
        class="bg-white p-5 rounded-2xl border border-slate-200/90 hover:border-red-300 shadow-sm hover:shadow-md transition group"
      >
        <div class="flex items-center justify-between">
          <div class="space-y-1">
            <h3 class="text-base font-black text-slate-900 group-hover:text-red-600 transition">
              Pengaturan Profil
            </h3>
            <p class="text-xs text-slate-500">Atur nama petugas default, unit PSC 119, dan backup data.</p>
          </div>
          <span class="text-slate-400 group-hover:text-red-600 transition text-lg font-bold">&rarr;</span>
        </div>
      </a>

      <a
        href="/tentang"
        class="bg-white p-5 rounded-2xl border border-slate-200/90 hover:border-red-300 shadow-sm hover:shadow-md transition group"
      >
        <div class="flex items-center justify-between">
          <div class="space-y-1">
            <h3 class="text-base font-black text-slate-900 group-hover:text-red-600 transition">
              Tentang TC-START
            </h3>
            <p class="text-xs text-slate-500">Penjelasan ilmiah metode triase dan panduan serah terima RS.</p>
          </div>
          <span class="text-slate-400 group-hover:text-red-600 transition text-lg font-bold">&rarr;</span>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>
